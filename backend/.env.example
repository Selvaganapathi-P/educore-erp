# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/educore

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=https://your-domain.com

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=EduCore ERP <noreply@your-domain.com>

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# Required for AI Assistant features. Get key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXX

# ── Super Admin Seed ─────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword!
